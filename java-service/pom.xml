<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- mock-oa 冒烟服务。手写 pom（start.spring.io 本机不可达）。
         版本基线来自 docs/task-cards/P0-01-dsh-brief.md §2，不要自创版本。
         P0-02 §0 起支持双存储 profile：sqlite（默认）/ postgres。 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.p2pagent</groupId>
    <artifactId>mock-oa</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mock-oa</name>
    <description>P2P Agent mock OA system (contract / trace propagation / idempotency / fault switch; storage profiles: sqlite, postgres)</description>

    <properties>
        <!-- 必须 21：javac 的 release 开关同时锁死语言级别与 JDK API（设成 17 会屏蔽 Thread.ofVirtual 等） -->
        <java.version>21</java.version>
        <springdoc.version>2.8.17</springdoc.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>
        <!-- PostgreSQL 驱动：版本交给 spring-boot-starter-parent 的 BOM 管，不写死 -->
        <!-- scope=runtime：编译期代码不会直接引用 org.postgresql.*（连接由 DriverManager 按 URL 解析） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 把 spring-boot:run 的工作目录钉死在 java-service/，
                         这样 SQLite 的 data/mock-oa.db 不管从哪里敲 maven 都落在同一处 -->
                    <workingDirectory>${project.basedir}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
